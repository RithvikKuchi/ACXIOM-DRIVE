@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button></div>
}
@if (TempData["Message"] is string message)
{
    <div class="alert alert-info" role="status">@message</div>
}
