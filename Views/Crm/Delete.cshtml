@model AcxiomCRM.ViewModels.CrmDetailsModel
@using AcxiomCRM.ViewModels
@{ ViewData["Title"] = "Delete " + CrmUi.Singular(Model.Kind); }
<div class="page-header"><a class="small text-decoration-none" asp-action="Details" asp-route-kind="@Model.Kind" asp-route-id="@Model.Item.Id">← Back to record</a><h1 class="mt-3">Delete @CrmUi.Singular(Model.Kind)</h1></div>
<div class="card" style="max-width:720px"><div class="card-body p-4 p-lg-5"><h2 class="h4">Delete “@CrmUi.Label(Model.Item)”?</h2><p class="text-muted">This action removes the record from your workspace. Its audit history is retained. Records that still have dependent CRM records cannot be deleted.</p><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div><dl class="row"><dt class="col-sm-4">Record</dt><dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Item.Code) ? "#" + Model.Item.Id : Model.Item.Code)</dd><dt class="col-sm-4">Owner</dt><dd class="col-sm-8">@Model.Item.OwnerName</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Item.Status</dd></dl><form asp-action="Delete" asp-route-kind="@Model.Kind" asp-route-id="@Model.Item.Id" method="post" class="d-flex gap-2"><button class="btn btn-danger" type="submit">Yes, delete @CrmUi.Singular(Model.Kind)</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-kind="@Model.Kind" asp-route-id="@Model.Item.Id">Keep record</a></form></div></div>
