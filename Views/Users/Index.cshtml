@model AcxiomCRM.ViewModels.UserListViewModel
@{ ViewData["Title"] = "Users & roles"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3 mb-1">Users & roles</h1><p class="text-muted mb-0">Manage access, account status and security.</p></div><a asp-action="Create" class="btn btn-primary">Add user</a></div>
<div class="row g-3 mb-4">
<div class="col-md-4"><div class="card p-3 h-100"><h2 class="h6">Admin</h2><p class="small text-muted mb-0">Full CRM, user administration, audit logs and all reports.</p></div></div>
<div class="col-md-4"><div class="card p-3 h-100"><h2 class="h6">Manager</h2><p class="small text-muted mb-0">Team CRM, pipeline and management reports. No security administration.</p></div></div>
<div class="col-md-4"><div class="card p-3 h-100"><h2 class="h6">Sales Executive</h2><p class="small text-muted mb-0">Assigned CRM records, scoped dashboard and sales reports.</p></div></div>
</div>
<div class="card"><div class="card-body"><form method="get" class="d-flex gap-2 mb-3"><label for="search" class="visually-hidden">Search users</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Search name or email" maxlength="254" /><button class="btn btn-outline-primary" type="submit">Search</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Lockout</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var user in Model.Users) {
<tr><td class="fw-semibold">@user.Name</td><td>@user.Email</td><td><span class="badge bg-light text-dark">@user.Role</span></td><td><span class="badge @(user.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td><td>@(user.LockoutEnd > DateTimeOffset.UtcNow ? user.LockoutEnd.Value.ToLocalTime().ToString("dd MMM HH:mm") : "Unlocked")</td><td class="text-end"><div class="d-flex gap-2 justify-content-end flex-wrap"><a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Reset password</a>@if(user.LockoutEnd > DateTimeOffset.UtcNow) { <form asp-action="Unlock" method="post"><input type="hidden" name="id" value="@user.Id" /><button class="btn btn-sm btn-outline-warning" type="submit">Unlock</button></form> }</div></td></tr>
}
@if (!Model.Users.Any()) { <tr><td colspan="6" class="text-muted py-4 text-center">No users match your search.</td></tr> }
</tbody></table></div>
<div class="d-flex justify-content-between align-items-center"><span class="text-muted small">@Model.Total users · Page @Model.Page of @Model.TotalPages</span><div class="d-flex gap-2">@if(Model.Page > 1) { <a asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)" class="btn btn-sm btn-outline-secondary">Previous</a> } @if(Model.Page < Model.TotalPages) { <a asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)" class="btn btn-sm btn-outline-secondary">Next</a> }</div></div>
</div></div>
